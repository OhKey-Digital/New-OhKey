---
import WhatsApp from "../components/global/WhatsApp.astro";
import About from "../components/section/About.astro";
import Benefit from "../components/section/Benefit.astro";
import Failure from "../components/section/Failure.astro";
import Goodbye from "../components/section/Goodbye.astro";
import Hero from "../components/section/Hero.astro";
import Module from "../components/section/Module.astro";
import Price from "../components/section/Price.astro";
import QyA from "../components/section/QyA.astro";
import Target from "../components/section/Target.astro";
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/shared/Marquee.astro";
---

<Layout>
	<Hero />
	<Marquee />
  <WhatsApp/>
	<Benefit />
	<Failure />
	<Target/>
	<Module/>
	<About/>
	<Price/>
	<QyA/>
	<Goodbye/>
</Layout>

<script>
  const START_DATE = new Date("2026-05-14T00:00:00");
  const MAX_VALUE = 100;

  function updateCounter() {
    const now = new Date();

    const diffInMs = now.getTime() - START_DATE.getTime();
    const daysPassed = Math.floor(diffInMs / (1000 * 60 * 60 * 12));

    const currentValue = MAX_VALUE - (daysPassed % MAX_VALUE);

	const event = new CustomEvent("counter", {detail: {value: currentValue}});
    window.dispatchEvent(event);
  }

  document.addEventListener("DOMContentLoaded", updateCounter)
</script>
