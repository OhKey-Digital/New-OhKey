---
import Footer from "../components/global/Footer.astro";
import Navbar from "../components/global/Navbar.astro";
import SEO from "../components/global/SEO.astro";
import JsonLd from "../components/global/JsonLd.astro";

import "../styles/reset.css";
import "../styles/variables.css";

// Fuente crítica importada como asset para obtener su URL con hash y precargarla.
import publicSans from "../assets/fonts/PublicSans-Variable.woff2";

// Props SEO que cada página puede sobreescribir; se delegan al componente <SEO />.
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: "website" | "article";
	noindex?: boolean;
}

const seo = Astro.props;

const pixelId = import.meta.env.PUBLIC_PIXEL_ID;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- Precarga de la fuente crítica (LCP del Hero): evita FOUT y reduce CLS -->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href={publicSans}
			crossorigin
		/>

		<meta
			name="facebook-domain-verification"
			content="8b977xy9ew64vn753rt8q678dju7k5"
		/>
		<meta name="generator" content={Astro.generator} />

		<!-- SEO: title, description, canonical, Open Graph y Twitter Cards -->
		<SEO {...seo} />

		<!-- Datos estructurados (Organization, WebSite, Course) -->
		<JsonLd />

		<!-- Meta Pixel Code -->
		<script is:inline data-pixel-id={pixelId}>
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod
						? n.callMethod.apply(n, arguments)
						: n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(
				window,
				document,
				"script",
				"https://connect.facebook.net/en_US/fbevents.js",
			);
			fbq("init", "782341138085266");
			fbq("track", "PageView");
		</script>

		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-W7LZPHR6");
		</script>
	</head>

	<body>
		<noscript
			><img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=782341138085266&ev=PageView&noscript=1"
			/></noscript
		>

		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-W7LZPHR6"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	import "../scripts/animations";
	import "../scripts/tracking";
</script>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		position: relative;
	}

	/* Elemento sobredimensionado para animar con transform (compositor-friendly)
	   sin repaints. El 20% extra en cada lado es el margen de translación segura. */
	body::before {
		content: "";
		position: fixed;
		top: -10%;
		left: -10%;
		width: 120%;
		height: 120%;
		z-index: -1;
		background-image: url("../assets/png/noise.png");
		opacity: 0.8;
		animation: noise-move 0.5s infinite;
		pointer-events: none;
		will-change: transform;
	}

	/* Máx. translación ±6% → 7.2vw/vh. Margen seguro disponible: 10vw/vh → ok. */
	@keyframes noise-move {
		0%,
		100% {
			transform: translate(0, 0);
		}
		10% {
			transform: translate(-3%, -5%);
		}
		20% {
			transform: translate(-6%, 3%);
		}
		30% {
			transform: translate(3%, -6%);
		}
		40% {
			transform: translate(6%, 5%);
		}
		50% {
			transform: translate(-5%, 4%);
		}
		60% {
			transform: translate(5%, 2%);
		}
		70% {
			transform: translate(0%, 5%);
		}
		80% {
			transform: translate(6%, 6%);
		}
		90% {
			transform: translate(-4%, 3%);
		}
	}
</style>
