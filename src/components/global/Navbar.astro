---
import BtnBasic from "../shared/button/BtnBasic.astro";
---

<nav class="navbar">
  <div class="nav-elements">
    <div class="invisible"></div>
    <BtnBasic class="btn" href="https://wa.me/593982422500" target="_blank"
      >QUIERO OBTENER EL CURSO</BtnBasic
    >
    <p class="quotas">CUPOS: <span id="countdown"></span> / 100</p>
  </div>
</nav>

<script>
  window.addEventListener("counter", ((event: CustomEvent) => {
    const value = event.detail.value;
    const span = document.getElementById("countdown");
    if (span) span.textContent = value;
  }) as EventListener);
</script>

<style>
  .navbar {
    width: 100%;
    padding: 0.5rem 0rem;
    display: flex;
    justify-content: center;
    position: sticky;
    top: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-primary);
    box-shadow: 0rem 0.5rem 0.5rem rgba(0, 0, 0, 0.4);

    .invisible {
      display: none;

      @media (min-width: 768px) {
        display: inline-block;
      }
    }

    .nav-elements {
      width: fit-content;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;

      .quotas {
        font-weight: var(--fw-bold);
        font-size: var(--fs-small);
        color: var(--color-bg);
      }

      @media (min-width: 768px) {
        height: 4rem;
        gap: 1rem;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
      }
    }
  }
</style>
