---
import BtnBasic from "../shared/button/BtnBasic.astro";
---

<nav class="navbar">
  <div class="nav-elements">
    <p class="discount">50% DESCUENTO</p>
    <BtnBasic class="btn" href="https://wa.me/593982422500" target="_blank"
      >QUIERO OBTENER EL CURSO</BtnBasic
    >
    <p class="quotas">CUPOS: <span id="countdown"></span> / 100</p>
  </div>
</nav>

<script>
  window.addEventListener("counter", ((event: CustomEvent) => {
    const value = event.detail.value;
    const span = document.getElementById("countdown");
    if(span) span.textContent = value;
  }) as EventListener);
</script>

<style>
  .navbar {
    width: 100%;
    height: 4rem;
    display: flex;
    justify-content: center;
    position: sticky;
    top: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-primary);
    box-shadow: 0rem 0.5rem 0.5rem rgba(0, 0, 0, 0.4);

    .nav-elements {
      width: fit-content;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      text-align: center;
      gap: 0.5rem;

      p {
        font-size: var(--fs-xs);
        color: var(--color-bg);
        flex-shrink: 0;
      }

      .discount {
        font-weight: var(--fw-extralight);
      }
      .quotas {
        font-weight: var(--fw-bold);
      }

      .btn {
        flex-shrink: 0;
      }

      @media (min-width: 768px){
        gap: 1rem;
      }
    }
  }
</style>
