---
import BtnBasic from "../button/BtnBasic.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    variant?: "none" | "border";
}

const { variant = "border", class: className, ...rest } = Astro.props;
---

<div class:list={["card", `variant-${variant}`, className]} {...rest as any}>
    <slot />
</div>

<script></script>

<style>
    .card{
        padding: 1rem;
        border-radius: 2rem;
        
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .variant-border{
        border: 0.1rem solid var(--color-quaternary);
    }

    .variant-none{
        background-color: color-mix(in srgb, var(--color-bg), transparent 50%);
    }
</style>
