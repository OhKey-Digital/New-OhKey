---
import BtnBasic from "../button/BtnBasic.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    variant?: "none" | "border";
}

const { variant = "border", class: className, ...rest } = Astro.props;
---

<div class:list={["card", `variant-${variant}`, className]} {...rest as any}>
    <slot />
</div>

<script></script>

<style>
    .card{
        max-width: 50%;
        padding: 1rem;
        flex: 0 1 calc(50% - 1rem);
        
        display: flex;
        flex-direction: column;
        align-items: center;

        @media (min-width: 768px){
            width: 100%;
            max-width: 12rem;
        }
    }

    .variant-border{
        border: 0.1rem solid var(--color-quaternary);
        border-radius: 30px;
    }
</style>
