---

<section class="modules-section reveal">
  <small class="modules__label">EL CAMINO</small>
  <h2 class="modules__heading">10 módulos <br /> +20 horas. Sin relleno.</h2>
  <p class="modules__description">
    Clases en vivo face to face, resuelves tus dudas de inmediato.
  </p>

  <div class="modules__accordion-group">
    {
      cardInfo.map((item) => (
        <AcdBase>
          <div slot="summary" class="modules__accordion-summary">
            <div class="container">
              <SvgSprite
                name={item.icon}
                size="1.5rem"
                class="modules__accordion-icon"
              />
              <p class="modules__accordion-number">{item.num}</p>
              <div class="modules__accordion-info">
                <h3 class="modules__accordion-title">{item.title}</h3>
              </div>
            </div>
            <SvgSprite name="addition" size="0.5rem" class="addition" />
          </div>

          <div slot="content" class="modules__section-container">
            {item.list.map((sectionObj) =>
              Object.values(sectionObj).map((content) => {
                if (
                  content &&
                  typeof content === "object" &&
                  "title" in content &&
                  "items" in content
                ) {
                  const sub = content as SubSection;
                  return (
                    <ul class="modules__sub-section">
                      <li class="modules__sub-title">{sub.title}</li>
                      {sub.items.map((subItem) => (
                        <li class="modules__points-list">
                          <SvgSprite
                            name="chevron"
                            size="0.9rem"
                            class="modules__point-icon"
                          />
                          <span>{subItem}</span>
                        </li>
                      ))}
                    </ul>
                  );
                }

                if (Array.isArray(content)) {
                  return (
                    <ul class="modules__section">
                      {(content as string[]).map((point) => (
                        <li class="modules__points-list">
                          <SvgSprite
                            name="check"
                            size="1rem"
                            class="modules__point-icon"
                          />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  );
                }

                return null;
              }),
            )}
          </div>
        </AcdBase>
      ))
    }
  </div>

  <div class="modules__cta">
    <BtnBasic
      bgColor="#303099"
      txColor="white"
      href="https://wa.me/593982422500"
      target="_blank"
    >
      QUIERO INSCRIBIRME
    </BtnBasic>
  </div>
</section>

<style>
  .modules-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-primary);
    font-size: var(--fs-small);
    padding: 2rem 4%;

    .modules__label {
      font-size: var(--fs-small);
      font-weight: var(--fw-bold);
    }

    .modules__heading {
      font-size: var(--fs-h3);
      font-weight: var(--fw-black);
    }

    .modules__description {
      font-size: var(--fs-body);
    }

    .modules__accordion-group {
      width: 100%;
      max-width: 30rem;
      margin-top: 1rem;

      .modules__accordion-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;

        .container {
          display: flex;
          align-items: center;

          /* Icono temático del módulo — ancla visual de cada cabecera */
          .modules__accordion-icon {
            margin-right: 0.6rem;
            color: var(--color-tertiary);
            flex-shrink: 0;
          }

          .modules__accordion-number {
            margin-right: 0.5rem;
            font-size: var(--fs-h4);
            font-weight: var(--fw-extrabold);
            color: var(--color-extra);
          }

          .modules__accordion-info {
            display: flex;
            align-items: center;
            .modules__accordion-title {
              font-weight: var(--fw-bold);
            }
          }
        }

        .addition {
          width: 0.5rem;
          height: 0.5rem;
          padding: 0.2rem;
          color: white;
          border-radius: 50%;
          background-color: var(--color-tertiary);

          transition: transform 0.5s ease;
        }
      }

      .modules__section-container {
        margin-left: 0.5rem;
        text-align: left;

        /* Viñeta con icono: el icono se alinea al inicio del texto y el
           span fluye en columna para textos de varias líneas */
        .modules__points-list {
          list-style: none;
          display: flex;
          align-items: flex-start;
          gap: 0.5rem;
          padding-top: 0.35rem;

          .modules__point-icon {
            margin-top: 0.15rem;
            color: var(--color-tertiary);
            flex-shrink: 0;
          }
        }

        .modules__sub-section {
          padding-top: 0.5rem;

          .modules__sub-title {
            list-style: none;
            font-weight: var(--fw-bold);
            color: var(--color-primary);
            padding-top: 0.35rem;
          }

          /* Sub-ítems: icono chevron en tono atenuado */
          .modules__points-list {
            margin-left: 0.75rem;

            .modules__point-icon {
              color: var(--color-extra);
            }
          }
        }
      }
    }

    .modules__cta {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 1rem;
    }
  }
</style>
