---

<section class="modules-section">
    <small class="modules__label">EL CAMINO</small>
    <h2 class="modules__heading">10 módulos. 40 horas. Sin relleno.</h2>
    <p class="modules__description">
        En 2 semanas si te dedicas, o en 2-3 meses con calma.
    </p>

    <div class="modules__accordion-group">
        {
            cardInfo.map((item) => (
                <AcdBase>
                    <div slot="summary" class="modules__accordion-summary">
                        <div class="container">
                            <p class="modules__accordion-number">{item.num}</p>
                            <div class="modules__accordion-info">
                                <h3 class="modules__accordion-title">
                                    {item.title}
                                </h3>
                                <p class="modules__accordion-text">
                                    {item.description}
                                </p>
                            </div>
                        </div>
                        <SvgSprite
                            name="addition"
                            size="0.5rem"
                            class="addition"
                        />
                    </div>
                    <ul slot="content" class="modules__points-list">
                        {item.list.map((sectionObj) =>
                            Object.values(sectionObj).map((points) =>
                                points.map((point) => <li>{point}</li>),
                            ),
                        )}
                    </ul>
                </AcdBase>
            ))
        }
    </div>

    <div class="modules__cta">
        <BtnBasic bgColor="#303099" txColor="white" href="https://wa.me/593982422500" target="_blank">
            QUIERO INSCRIBIRME
        </BtnBasic>
        <small class="modules__cta-caption">ACCESO DE POR VIDA</small>
    </div>
</section>

<style>
    .modules-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--color-primary);
        font-size: var(--fs-small);
        padding: 2rem 4%;

        .modules__label {
            font-size: var(--fs-small);
            font-weight: var(--fw-bold);
        }

        .modules__heading {
            max-width: 15rem;
            font-size: var(--fs-h3);
            font-weight: var(--fw-black);
        }

        .modules__description {
            font-size: var(--fs-body);
        }

        .modules__accordion-group {
            width: 100%;
            max-width: 30rem;
            margin-top: 1rem;

            .modules__accordion-summary {
                display: flex;
                align-items: center;
                justify-content: space-between;

                .container {
                    display: flex;

                    .modules__accordion-number {
                        margin-right: 0.5rem;
                        font-size: var(--fs-h4);
                        font-weight: var(--fw-extrabold);
                        color: var(--color-extra);
                    }

                    .modules__accordion-info {
                        .modules__accordion-title {
                            font-weight: var(--fw-bold);
                        }
                    }
                }

                .addition {
                    width: 0.5rem;
                    height: 0.5rem;
                    padding: 0.2rem;
                    color: white;
                    border-radius: 50%;
                    background-color: var(--color-tertiary);

                    transition: transform 0.5s ease;
                }
            }

            .modules__points-list {
                padding: 0.5rem 2.4rem 0rem;
                list-style: disc;
                text-align: left;
            }
        }

        .modules__cta {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-top: 1rem;
        }
    }
</style>
