---
import BtnBasic from "../shared/button/BtnBasic.astro";
import CrdBasic from "../shared/card/CrdBasic.astro";

interface priceCard {
  priceFull: string;
  priceOff: string;
  list: Array<string>;
  btn: string;
}

const cardDetail: priceCard[] = [
  {
    priceFull: "$80 USD",
    priceOff: "$60",
    list: [
      "10 módulos",
      "Clases en vivo Mier/Jueves/Vier 18:00",
      "Grabaciones permanentes",
      "+20 plantillas profesionales de OhKey",
      "Comunidad WhatsApp",
      "Acceso de por vida + actualizaciones",
    ],
    btn: "ACCEDER AHORA",
  },
  {
    priceFull: "$150 USD",
    priceOff: "$120",
    list: [
      "1:1 Tutorías 8 horas - Investigación profunda de tu mercado / Creación de estrategia / creación de campañas / Optimización",
      "10 módulos",
      "Clases en vivo Mier/Jueves/Vier 18:00",
      "Grabaciones permanentes",
      "+20 plantillas profesionales de OhKey",
      "Comunidad WhatsApp",
      "Acceso de por vida + actualizaciones",
      "Cursos futuros con descuento",
    ],
    btn: "QUIERO MI EXPERIENCIA PRO",
  },
];
---

<section class="price-section reveal">
  {
    cardDetail.map((item) => (
      <div class="price__card-container">
        <CrdBasic variant="none">
          <small class="price-after">{item.priceFull}</small>
          <p class="price-now">{item.priceOff}</p>
          <p class="price-now-detail">USD - PAGO ÚNICO</p>

          <ul class="price-benefit-list">
            {item.list.map((li) => (
              <li>{li}</li>
            ))}
          </ul>

          <BtnBasic
            bgColor="#303099"
            txColor="white"
            href="https://wa.me/593982422500"
            target="_blank"
          >
            {item.btn}
          </BtnBasic>
        </CrdBasic>
      </div>
    ))
  }

  <small class="counter">
    <span id="countdown-price"></span>/100 CUPOS <b
      >- <span id="available"></span> disponibles</b
    ></small
  >
</section>

<script>
  window.addEventListener("counter", ((event: CustomEvent) => {
    const value = event.detail.value;
    const span = document.getElementById("countdown-price");
    if (span) span.textContent = value;

    const span2 = document.getElementById("available");
    if (span2) span2.textContent = value;
  }) as EventListener);
</script>

<style>
  .price-section {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr auto;
    justify-items: center;
    text-align: center;
    color: white;
    background-color: var(--color-primary);
    font-size: var(--fs-small);
    padding: 2rem 4%;
    gap: 2rem;

    .price__card-container {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      width: fit-content;
      height: 100%;
      background-color: var(--color-quaternary);

      .card {
        background-color: white;
        color: var(--color-primary);
        max-width: 15rem;
        height: 100%;
        justify-content: center;
      }

      .price-after {
        text-decoration: line-through;
        font-weight: var(--fw-light);
      }

      .price-now {
        font-weight: var(--fw-black);
        font-size: 4rem;
      }

      .price-now-detail {
        font-weight: var(--fw-light);
      }

      .price-benefit-list {
        list-style: disc;
        text-align: start;
        padding: 0.5rem 0rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      &:nth-child(2) {
        .price-benefit-list li:first-child {
          font-weight: var(--fw-black);
        }
      }
    }

    .counter {
      font-size: var(--fs-body);
    }

    @media (min-width: 1024px) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto;

      .price__card-container {
        &:nth-child(1) {
          justify-self: end;
        }

        &:nth-child(2) {
          justify-self: start;
        }
      }

      .counter {
        grid-column-start: 1;
        grid-column-end: 3;
      }
    }
  }
</style>
