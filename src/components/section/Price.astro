---
import BtnBasic from "../shared/button/BtnBasic.astro";
import CrdBasic from "../shared/card/CrdBasic.astro";
import SvgSprite from "../shared/svg/SvgSprite.astro";

interface priceCard {
  priceFull: string;
  priceOff: string;
  list: Array<string>;
  btn: string;
}

// Asigna un icono contextual a cada característica del plan.
// El orden importa: "Sin cursos…" (negativo) se evalúa antes que "Cursos…".
function iconFor(feature: string): string {
  const f = feature.toLowerCase();
  if (f.startsWith("sin ")) return "cross"; // beneficio NO incluido
  // Características exclusivas del plan PRO ($120) — iconos temáticos por módulo
  if (f.includes("investigación")) return "mod-research";
  if (f.includes("estrategias"))   return "mod-scale";
  if (f.includes("campañas"))      return "mod-ads";
  if (f.includes("optimización"))  return "mod-optimize";
  if (f.includes("claude") || f.includes("análisis")) return "mod-ai";
  if (f.includes("módulos")) return "mod-base";
  if (f.includes("clases en vivo")) return "video";
  if (f.includes("grabaciones")) return "clock";
  if (f.includes("plantillas")) return "template";
  if (f.includes("comunidad")) return "users";
  if (f.includes("tutorías")) return "tutoring";
  if (f.includes("descuento")) return "discount";
  return "check";
}

const cardDetail: priceCard[] = [
  {
    priceFull: "$80 USD",
    priceOff: "$60",
    list: [
      "11 módulos",
      "Clases en vivo",
      "Accesos a grabaciones por 1 semana",
      "+20 plantillas OhKey",
      "Comunidad Activa",
      "Sin cursos futuros con descuento",
    ],
    btn: "ACCEDER AHORA",
  },
  {
    priceFull: "$150 USD",
    priceOff: "$120",
    list: [
      "1:1 Tutorías 8 horas",
      "Investigación profunda de tu mercado",
      "Creación de estrategias",
      "Creación de Campañas",
      "Optimización",
      "Skills de análisis para Claude",
      "11 módulos",
      "Clases en vivo",
      "Accesos a grabaciones por 3 meses",
      "+20 plantillas OhKey",
      "Comunidad Activa",
      "Cursos futuros con descuento",
    ],
    btn: "QUIERO MI EXPERIENCIA PRO",
  },
];
---

<section class="price-section">
  {
    cardDetail.map((item) => (
      <div class="price__card-container">
        <CrdBasic variant="none">
          <small class="price-after">{item.priceFull}</small>
          <p class="price-now">{item.priceOff}</p>
          <p class="price-now-detail">USD - PAGO ÚNICO</p>

          <ul class="price-benefit-list">
            {item.list.map((li) => {
              const icon = iconFor(li);
              return (
                <li class:list={["price-benefit", { "is-excluded": icon === "cross" }]}>
                  <SvgSprite name={icon} size="1.1rem" class="price-benefit-icon" />
                  <span>{li}</span>
                </li>
              );
            })}
          </ul>

          <BtnBasic
            bgColor="#303099"
            txColor="white"
            href="https://wa.me/593982422500"
            target="_blank"
          >
            {item.btn}
          </BtnBasic>
        </CrdBasic>
      </div>
    ))
  }

  <small class="counter">
    <span id="countdown-price"></span>/50 CUPOS <b
      >- <span id="available"></span> disponibles</b
    ></small
  >
</section>

<script>
  window.addEventListener("counter", ((event: CustomEvent) => {
    const currentValue = event.detail.currentValue;
    const restValue = event.detail.restValue;
    const span = document.getElementById("countdown-price");
    if (span) span.textContent = restValue;

    const span2 = document.getElementById("available");
    if (span2) span2.textContent = currentValue;
  }) as EventListener);
</script>

<style>
  .price-section {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr auto;
    justify-items: center;
    text-align: center;
    color: white;
    background-color: var(--color-primary);
    font-size: var(--fs-small);
    padding: 2rem 4%;
    gap: 2rem;

    .price__card-container {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      width: fit-content;
      height: 100%;
      background-color: var(--color-quaternary);

      .card {
        background-color: white;
        color: var(--color-primary);
        max-width: 15rem;
        height: 100%;
        justify-content: center;
      }

      .price-after {
        text-decoration: line-through;
        font-weight: var(--fw-light);
      }

      .price-now {
        font-weight: var(--fw-black);
        font-size: 4rem;
      }

      .price-now-detail {
        font-weight: var(--fw-light);
      }

      .price-benefit-list {
        list-style: none;
        text-align: start;
        padding: 0.5rem 0rem 1rem 0rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;

        .price-benefit {
          display: flex;
          align-items: center;
          gap: 0.5rem;

          .price-benefit-icon {
            margin-top: 0.15rem;
            color: var(--color-tertiary);
            flex-shrink: 0;
          }

          /* Beneficio NO incluido: icono y texto atenuados */
          &.is-excluded {
            color: var(--color-extra);

            .price-benefit-icon {
              color: var(--color-extra);
            }

            span {
              text-decoration: line-through;
            }
          }
        }
      }

      &:nth-child(2) {
        .price-benefit-list .price-benefit:first-child {
          font-weight: var(--fw-black);
        }
      }
    }

    .counter {
      font-size: var(--fs-body);
    }

    @media (min-width: 1024px) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto;

      .price__card-container {
        &:nth-child(1) {
          justify-self: end;
        }

        &:nth-child(2) {
          justify-self: start;
        }
      }

      .counter {
        grid-column-start: 1;
        grid-column-end: 3;
      }
    }
  }
</style>
