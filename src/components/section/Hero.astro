---
import BtnBasic from "../shared/button/BtnBasic.astro";
import CrdBasic from "../shared/card/CrdBasic.astro";
import SvgSingle from "../shared/svg/SvgSingle.astro";
import SvgSprite from "../shared/svg/SvgSprite.astro";

interface HeroCard {
  title: string;
  description: string;
}

const statsInfo: HeroCard[] = [
  {
    title: "$3➜$500k",
    description: "en presupuestos manejados directamente",
  },
  {
    title: "+100",
    description: "estudiantes que han aprendido conmigo",
  },
  {
    title: "+10 años",
    description: "en Pais Media y estrategia digital",
  },
  {
    title: "En Vivo",
    description: "clases donde resuelves dudas en tiempo real",
  },
];
---

<section class="hero-section">
  <SvgSingle name="logo" width="10rem" />

  <h1 class="hero__title">
    El primer curso de <span>Meta Ads en Ecuador</span> diseñado para quien empieza desde $50
    — <span>aprende a hacer rendir cada dólar</span> antes de escalar.
  </h1>

  <p class="hero__copy">
    El único curso que combina fundamentos de marketing reales, estratégias
    prácticas de Meta Ads sin tecnicismos, y los bonos que uso con mis clientes.
  </p>

  <ul class="hero__features">
    <li>
      <SvgSprite name="arrow" size="0.8rem" color="white" class="arrow" /> Fundamentos
      de Marketing que funcionan
    </li>
    <li>
      <SvgSprite
        name="arrow"
        size="0.8rem"
        color="white"
        class="arrow"
      />Estrategias prácticas - sin tecnicismos innecesarios
    </li>
    <li>
      <SvgSprite name="arrow" size="0.8rem" color="white" class="arrow" />Bonos
      gratuitos que uso con mis clientes
    </li>
  </ul>

  <div class="hero__cta-group">
    <BtnBasic
      bgColor="#303099"
      txColor="white"
      href="https://wa.me/593982422500"
      target="_blank"
    >
      QUIERO DOMINAR META ADS
    </BtnBasic>
    <small class="hero__cta-caption">ACCESO DE POR VIDA</small>
  </div>

  <div class="hero__stats-grid">
    {
      statsInfo.map((item) => (
        <CrdBasic class="hero__stat-card">
          <h2 class="hero__stat-title">{item.title}</h2>
          <p class="hero__stat-description">{item.description}</p>
        </CrdBasic>
      ))
    }
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--color-primary);
    text-align: center;
    padding: 2rem 4%;
    font-size: var(--fs-small);

    .hero__title {
      max-width: 25rem;
      font-size: var(--fs-h4);
      font-weight: var(--fw-black);

      span {
        color: var(--color-secondary);
      }
    }

    .hero__copy {
      max-width: 17rem;
      font-weight: var(--fw-extralight);
    }

    .hero__features {
      max-width: 18rem;

      .arrow {
        background-color: var(--color-primary);
        border-radius: 2rem;
        margin-right: 0.2rem;
      }
    }

    .hero__cta-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .hero__stats-grid {
      width: 100%;
      display: flex;
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.5rem;

      .hero__stat-card {
        flex: 1 1 calc(50% - 1rem);

        .hero__stat-title {
          font-weight: var(--fw-black);
        }

        .hero__stat-description {
          max-width: 6rem;
          margin-inline: auto;
        }

        @media (min-width: 768px) {
          flex: 0 1 12rem;
        }
      }
    }
  }
</style>
