---
import CrdBasic from "../shared/card/CrdBasic.astro";
import SvgSprite from "../shared/svg/SvgSprite.astro";

interface TargetCard {
    description: string;
    // Ícono relacionado con la descripción. Debe coincidir con un id de /public/sprites.svg
    icon: string;
}

const targetAudience: TargetCard[] = [
    {
        description:
            "Nunca has creado una campaña.",
        icon: "mod-launch",
    },
    {
        description:
            "Ya hiciste anuncios, pero no funcionaron.",
        icon: "mod-ads",
    },
    {
        description:
            "Tienes una cuenta nueva.",
        icon: "user-plus",
    },
    {
        description:
            "Tienes una cuenta con historial y no sabes cómo aprovecharla.",
        icon: "clock",
    },
    {
        description:
            "Quieres vender más sin depender de agencias.",
        icon: "mod-scale",
    },
    {
        description:
            "Tienes presupuesto pequeño y quieres empezar a invertir.",
        icon: "coin",
    },
];
---

<section class="target-section">
    <small class="target__caption">¿PARA QUIÉN ES?</small>
    <h2 class="target__title">Este entrenamiento es para ti, si...</h2>

    <div class="target__grid">
        {
            targetAudience.map((item) => (
                <CrdBasic variant="none" class="target__card">
                    {/*
                        Ícono relacionado con la descripción, al principio de cada tarjeta.
                        Va antes del <p>. El id sale de item.icon (ver targetAudience).
                        Ajusta el ícono desde la data o agrega nuevos en /public/sprites.svg.
                    */}
                    <SvgSprite name={item.icon} size="1.1rem" class="target__card-icon" />
                    <p class="target__card-description">{item.description}</p>
                </CrdBasic>
            ))
        }
    </div>
</section>

<style>
    .target-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--color-primary);
        background-color: var(--color-quaternary);
        font-size: var(--fs-small);
        padding: 2rem 4%;

        .target__caption {
            font-size: var(--fs-small);
            font-weight: var(--fw-bold);
        }

        .target__title {
            max-width: 20rem;
            font-size: var(--fs-h3);
            font-weight: var(--fw-black);
        }

        .target__grid {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-top: 1rem;
            align-items: stretch;

            .target__card {
                width: 100%;
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: 0.5rem;

                .target__card-icon {
                    color: var(--color-primary);
                    flex-shrink: 0;
                }

                .target__card-description {
                    font-weight: var(--fw-light);
                    width: 100%;
                    height: fit-content;
                    align-self: center;
                    text-align: start;
                }
            }

            @media (min-width: 768px) {
                max-width: 42rem;
                display: grid;
                grid-template-columns: 1fr 1fr;
                justify-content: center;
            }
        }
    }
</style>
